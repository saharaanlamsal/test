# ===== Server =====
PORT=4000
# Public URL of THIS backend once deployed (used to build eSewa success/failure redirect URLs)
APP_BASE_URL=https://your-backend.up.railway.app
# Public URL of your website (used to redirect the customer back after payment)
SITE_BASE_URL=https://bookmytestnepal.com.np

# ===== eSewa =====
# TEST/SANDBOX values (leave as-is until you have real merchant credentials):
ESEWA_MODE=test
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# When you get real credentials from eSewa merchant onboarding, set:
# ESEWA_MODE=live
# ESEWA_MERCHANT_CODE=your-real-merchant-code
# ESEWA_SECRET_KEY=your-real-secret-key

# ===== Khalti =====
# TEST/SANDBOX mode (uses dev.khalti.com — no real charge):
KHALTI_MODE=test
KHALTI_SECRET_KEY=your-khalti-test-secret-key
# When you're ready to go live, set:
# KHALTI_MODE=live
# KHALTI_SECRET_KEY=your-khalti-live-secret-key

# ===== Bank Transfer (manual — shown to customer, you verify manually) =====
BANK_NAME=Nepal Bank Limited
BANK_ACCOUNT_NAME=BookMyTest / Manigram Connection
BANK_ACCOUNT_NUMBER=0000000000000
BANK_BRANCH=Butwal Branch

# ===== FonePay (manual — shown to customer, you verify manually) =====
FONEPAY_MERCHANT_NAME=BookMyTest
FONEPAY_ID=0000000

# ===== Email (used to notify you + the customer) =====
# Example using Gmail: create an "App Password" at https://myaccount.google.com/apppasswords
# (regular Gmail password will NOT work)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-character-app-password
# Where booking notifications are sent
ADMIN_EMAIL=planetarynepal@gmail.com
ADMIN_PHONE_DISPLAY=9857035643
